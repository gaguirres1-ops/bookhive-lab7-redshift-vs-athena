        <mxCell id="p19" parent="1" style="ellipse;html=1;fillColor=#1E5BB8;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="4" vertex="1">
